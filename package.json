{
  "name": "linked-archi-metamodel-studio",
  "version": "0.1.0",
  "description": "Design complete Linked.Archi metamodels and export them as semantic asset sets (OWL, SHACL, SKOS, viewpoints, notation, arch:Metamodel manifest).",
  "license": "Apache-2.0",
  "private": true,
  "homepage": "https://linked-archi.github.io/metamodel-studio/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linked-archi/metamodel-studio.git"
  },
  "main": "index.js",
  "bin": {
    "la-studio": "scripts/cli.js"
  },
  "files": [
    "index.js",
    "index.html",
    "styles.css",
    "favicon.svg",
    "js/",
    "vendor/",
    "templates/",
    "scripts/cli.js",
    "scripts/page.js",
    "NOTICE"
  ],
  "scripts": {
    "test": "node --test tests/studio.test.js tests/package.test.js",
    "test:kernel": "vitest --run --config tests/kernel/vitest.config.mjs",
    "test:ui": "node --test tests/ui/",
    "build": "node scripts/build.js",
    "templates": "node scripts/build-templates.js",
    "fixtures": "node scripts/sync-fixtures.mjs",
    "serve": "node scripts/cli.js serve"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@linked-archi/kernel": "file:../linked-archi-kernel/linked-archi-kernel-0.0.0.tgz",
    "playwright": "1.63.0",
    "vitest": "^4.1.12"
  }
}
